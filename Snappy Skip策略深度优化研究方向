  三层架构:                                                                                                                                                                                                          
                                                                                                                                                                                                                     
  // 第1层: 文件级自适应 (一次性决策)                                                                                                                                                                                
  class FileLevelAdapter {                                                                                                                                                                                           
      uint32_t base_skip;                                                                                                                                                                                            
                                                                                                                                                                                                                     
      void analyze_file(const char* data, size_t size) {                                                                                                                                                             
          // 计算文件级特征                                                                                                                                                                                          
          float entropy = calculate_entropy(data, size);                                                                                                                                                             
          float compressibility = estimate_compressibility(data, size);                                                                                                                                              
                                                                                                                                                                                                                     
          if (compressibility > 0.8) {                                                                                                                                                                               
              base_skip = 32;  // 高可压缩，保守                                                                                                                                                                     
          } else if (compressibility < 0.3) {                                                                                                                                                                        
              base_skip = 64;  // 低可压缩，激进                                                                                                                                                                     
          } else {                                                                                                                                                                                                   
              base_skip = 48;  // 中等                                                                                                                                                                               
          }                                                                                                                                                                                                          
      }                                                                                                                                                                                                              
  };                                                                                                                                                                                                                 
                                                                                                                                                                                                                     
  // 第2层: 块级自适应 (每8KB调整一次)                                                                                                                                                                               
  class BlockLevelAdapter {                                                                                                                                                                                          
      uint32_t adjust_for_block(const char* block, size_t size, uint32_t base_skip) {                                                                                                                                
          float block_entropy = calculate_entropy(block, size);                                                                                                                                                      
          uint32_t match_count_in_block = count_matches(block, size);                                                                                                                                                
                                                                                                                                                                                                                     
          // 基于块特征微调                                                                                                                                                                                          
          return base_skip * (1.0f + (1.0f - match_count_in_block / expected_matches) * 0.5f);                                                                                                                       
      }                                                                                                                                                                                                              
  };                                                                                                                                                                                                                 
                                                                                                                                                                                                                     
  // 第3层: 局部自适应 (每次查找决策)                                                                                                                                                                                
  class LocalAdapter {                                                                                                                                                                                               
      uint32_t adjust_for_context(uint32_t block_skip, Context ctx) {                                                                                                                                                
          if (ctx.recent_match_rate > 0.6) {                                                                                                                                                                         
              return block_skip * 0.8;  // 提高密度                                                                                                                                                                  
          } else if (ctx.consecutive_misses > 10) {                                                                                                                                                                  
              return block_skip * 1.5;  // 降低密度                                                                                                                                                                  
          }                                                                                                                                                                                                          
          return block_skip;                                                                                                                                                                                         
      }                                                                                                                                                                                                              
  };                                                                                                                                                                                                                 
                                                                                                                                                                                                                     
  优势:                                                                                                                                                                                                              
  - 多粒度适应                                                                                                                                                                                                       
  - 每层开销可控                                                                                                                                                                                                     
  - 组合效果优于单层                                                                                                                                                                                                 
                                                                                                                                                                                                                     
