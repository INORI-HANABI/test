  实现思路:                                                                                                                                                                                                          
                                                                                                                                                                                                                     
  // 参数染色体                                                                                                                                                                                                      
  struct SkipChromosome {                                                                                                                                                                                            
      uint32_t skip_low;                                                                                                                                                                                             
      uint32_t skip_mid;                                                                                                                                                                                             
      uint32_t skip_high;                                                                                                                                                                                            
      uint32_t shift;                                                                                                                                                                                                
      uint32_t threshold_low;                                                                                                                                                                                        
      uint32_t threshold_high;                                                                                                                                                                                       
      float fitness;  // 适应度 = alpha * speedup - beta * compression_loss                                                                                                                                          
  };                                                                                                                                                                                                                 
                                                                                                                                                                                                                     
  class GeneticOptimizer {                                                                                                                                                                                           
      std::vector<SkipChromosome> population;                                                                                                                                                                        
                                                                                                                                                                                                                     
      void evolve() {                                                                                                                                                                                                
          for (int generation = 0; generation < max_generations; ++generation) {                                                                                                                                     
              // 1. 评估适应度                                                                                                                                                                                       
              for (auto& chrom : population) {                                                                                                                                                                       
                  chrom.fitness = evaluate_on_silesia(chrom);                                                                                                                                                        
              }                                                                                                                                                                                                      
                                                                                                                                                                                                                     
              // 2. 选择                                                                                                                                                                                             
              auto parents = selection(population);                                                                                                                                                                  
                                                                                                                                                                                                                     
              // 3. 交叉                                                                                                                                                                                             
              auto offspring = crossover(parents);                                                                                                                                                                   
                                                                                                                                                                                                                     
              // 4. 变异                                                                                                                                                                                             
              mutation(offspring);                                                                                                                                                                                   
                                                                                                                                                                                                                     
              // 5. 替换                                                                                                                                                                                             
              population = replacement(population, offspring);                                                                                                                                                       
          }                                                                                                                                                                                                          
      }                                                                                                                                                                                                              
  };                                                                                                                                                                                                                 
                                                                                                                                                                                                                     
  优化目标:                                                                                                                                                                                                          
  fitness = w1 * speedup - w2 * compression_loss - penalty(out_of_constraint)                                                                                                                                        
                                                                                                                                                                                                                     
  约束: compression_loss < 1%                                                                                                                                                                                        
                                                                                                                                                                                                                     
  优势:                                                                                                                                                                                                              
  - 全局搜索能力                                                                                                                                                                                                     
  - 可处理非线性目标函数                                                                                                                                                                                             
  - 无需梯度信息                                                                                                                                                                                                     
                                                                                                                                                                                                                     
  挑战:                                                                                                                                                                                                              
  - 评估计算成本高                                                                                                                                                                                                   
  - 需要大量测试运行                                                                                                                                                                                                 
                                                                                                                                                                                                                     
