  MDP 建模:                                                                                                                                                                                                          
                                                                                                                                                                                                                     
  状态 s_t: {position, recent_matches, hash_table_state, current_skip}                                                                                                                                               
  动作 a_t: {next_skip_value}                                                                                                                                                                                        
  奖励 r_t: {found_match ? +1 : -cost_of_lookup}                                                                                                                                                                     
                                                                                                                                                                                                                     
  目标: 最大化长期累积奖励                                                                                                                                                                                           
                                                                                                                                                                                                                     
  实现框架:                                                                                                                                                                                                          
                                                                                                                                                                                                                     
  // 使用 PPO 或 DQN                                                                                                                                                                                                 
  class SkipPolicyNetwork {                                                                                                                                                                                          
      // 简化状态表示                                                                                                                                                                                                
      struct State {                                                                                                                                                                                                 
          float match_rate_last_100;                                                                                                                                                                                 
          float avg_distance_last_10;                                                                                                                                                                                
          uint32_t current_skip;                                                                                                                                                                                     
      };                                                                                                                                                                                                             
                                                                                                                                                                                                                     
      // 动作空间: skip ∈ {16, 24, 32, 40, 48, 56, 64, 80, 96, 128}                                                                                                                                                  
                                                                                                                                                                                                                     
      torch::Tensor forward(const State& s) {                                                                                                                                                                        
          auto features = encode_state(s);                                                                                                                                                                           
          return policy_head(features);  // 输出动作概率分布                                                                                                                                                         
      }                                                                                                                                                                                                              
  };                                                                                                                                                                                                                 
                                                                                                                                                                                                                     
  // 训练循环                                                                                                                                                                                                        
  void train_policy() {                                                                                                                                                                                              
      for (int episode = 0; episode < num_episodes; ++episode) {                                                                                                                                                     
          auto trajectory = compress_with_policy(file, policy);                                                                                                                                                      
          auto rewards = calculate_returns(trajectory);                                                                                                                                                              
                                                                                                                                                                                                                     
          // PPO 更新                                                                                                                                                                                                
          update_policy(trajectory, rewards);                                                                                                                                                                        
      }                                                                                                                                                                                                              
  }                                                                                                                                                                                                                  
                                                                                                                                                                                                                     
